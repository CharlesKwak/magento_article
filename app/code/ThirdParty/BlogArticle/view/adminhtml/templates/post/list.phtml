<?php
/** @var \ThirdParty\BlogArticle\Block\Adminhtml\Post $block */
$posts = $block->getPosts();
$searchQuery = $block->getSearchQuery();
$statusFilter = $block->getStatusFilter();
$categoryFilter = $block->getCategoryIdFilter();
?>
<div class="blogarticle-post-list">
    <div class="page-actions" style="margin-bottom: 1rem; display:flex; gap:1rem; flex-wrap:wrap; align-items:center;">
        <a class="action-default scalable primary"
           href="<?= $block->escapeUrl($block->getNewUrl()) ?>">
            <span><?= $block->escapeHtml(__('Add New Post')) ?></span>
        </a>
    </div>

    <form method="get" action="<?= $block->escapeUrl($block->getFilterFormAction()) ?>"
          style="margin-bottom: 1.25rem; display:flex; gap:0.75rem; flex-wrap:wrap; align-items:end;">
        <div>
            <label for="admin-blog-q"><?= $block->escapeHtml(__('Search')) ?></label><br/>
            <input type="text"
                   id="admin-blog-q"
                   name="q"
                   value="<?= $block->escapeHtmlAttr($searchQuery) ?>"
                   placeholder="<?= $block->escapeHtmlAttr(__('Title, content, URL key')) ?>"
                   style="min-width:220px;"/>
        </div>
        <div>
            <label for="admin-blog-status"><?= $block->escapeHtml(__('Status')) ?></label><br/>
            <select id="admin-blog-status" name="status">
                <option value="" <?= $statusFilter === '' ? 'selected="selected"' : '' ?>>
                    <?= $block->escapeHtml(__('All')) ?>
                </option>
                <option value="1" <?= $statusFilter === '1' ? 'selected="selected"' : '' ?>>
                    <?= $block->escapeHtml(__('Enabled')) ?>
                </option>
                <option value="0" <?= $statusFilter === '0' ? 'selected="selected"' : '' ?>>
                    <?= $block->escapeHtml(__('Disabled')) ?>
                </option>
            </select>
        </div>
        <div>
            <label for="admin-blog-category"><?= $block->escapeHtml(__('Category')) ?></label><br/>
            <select id="admin-blog-category" name="category_id">
                <option value=""><?= $block->escapeHtml(__('All')) ?></option>
                <?php foreach ($block->getCategoryOptions() as $category): ?>
                    <option value="<?= (int) $category->getId() ?>"
                        <?= $categoryFilter === (int) $category->getId() ? 'selected="selected"' : '' ?>>
                        <?= $block->escapeHtml($category->getName()) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>
        <div>
            <button type="submit" class="action-default scalable">
                <span><?= $block->escapeHtml(__('Filter')) ?></span>
            </button>
            <?php if ($searchQuery !== '' || $statusFilter !== '' || $categoryFilter): ?>
                <a href="<?= $block->escapeUrl($block->getFilterFormAction()) ?>" style="margin-left:0.5rem;">
                    <?= $block->escapeHtml(__('Reset')) ?>
                </a>
            <?php endif; ?>
        </div>
    </form>

    <?php if (!$posts->getSize()): ?>
        <div class="message info">
            <?php if ($searchQuery !== '' || $statusFilter !== '' || $categoryFilter): ?>
                <span><?= $block->escapeHtml(__('No posts match the current filters.')) ?></span>
            <?php else: ?>
                <span><?= $block->escapeHtml(__('No blog posts yet. Click “Add New Post” to create one.')) ?></span>
            <?php endif; ?>
        </div>
    <?php else: ?>
        <table class="data-grid" style="width:100%; border-collapse: collapse;">
            <thead>
            <tr>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #ccc;"><?= $block->escapeHtml(__('ID')) ?></th>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #ccc;"><?= $block->escapeHtml(__('Title')) ?></th>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #ccc;"><?= $block->escapeHtml(__('Category')) ?></th>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #ccc;"><?= $block->escapeHtml(__('URL Key')) ?></th>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #ccc;"><?= $block->escapeHtml(__('Status')) ?></th>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #ccc;"><?= $block->escapeHtml(__('Created')) ?></th>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #ccc;"><?= $block->escapeHtml(__('Actions')) ?></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($posts as $post): ?>
                <tr>
                    <td style="padding:8px; border-bottom:1px solid #eee;">
                        <?= $block->escapeHtml((string) $post->getId()) ?>
                    </td>
                    <td style="padding:8px; border-bottom:1px solid #eee;">
                        <?= $block->escapeHtml($post->getTitle()) ?>
                    </td>
                    <td style="padding:8px; border-bottom:1px solid #eee;">
                        <?= $block->escapeHtml($block->getCategoryName($post) ?: '—') ?>
                    </td>
                    <td style="padding:8px; border-bottom:1px solid #eee;">
                        <code><?= $block->escapeHtml((string) $post->getUrlKey()) ?></code>
                    </td>
                    <td style="padding:8px; border-bottom:1px solid #eee;">
                        <?= $block->escapeHtml((int) $post->getIsActive() ? __('Enabled') : __('Disabled')) ?>
                    </td>
                    <td style="padding:8px; border-bottom:1px solid #eee;">
                        <?= $block->escapeHtml((string) $post->getCreationTime()) ?>
                    </td>
                    <td style="padding:8px; border-bottom:1px solid #eee;">
                        <a href="<?= $block->escapeUrl($block->getEditUrl($post->getId())) ?>">
                            <?= $block->escapeHtml(__('Edit')) ?>
                        </a>
                        &nbsp;|&nbsp;
                        <a href="<?= $block->escapeUrl($block->getFrontendViewUrl($post)) ?>" target="_blank" rel="noopener">
                            <?= $block->escapeHtml(__('View')) ?>
                        </a>
                        &nbsp;|&nbsp;
                        <a href="<?= $block->escapeUrl($block->getDeleteUrl($post->getId())) ?>"
                           onclick="return confirm('<?= $block->escapeJs(__('Are you sure you want to delete this post?')) ?>');">
                            <?= $block->escapeHtml(__('Delete')) ?>
                        </a>
                    </td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</div>
