                              name="content"
                              required="required"
                              rows="12"
                              style="width:100%; max-width:640px;"><?= $block->escapeHtml((string) $post->getContent()) ?></textarea>
                    <p class="admin__field-note">
                        <?= $block->escapeHtml(__('Basic HTML is allowed (for example p, strong, em, a, ul, ol, li). Only trusted staff should edit content.')) ?>
                    </p>
                </div>
            </div>

            <div class="admin__field">
