<?php
/** @var \ThirdParty\BlogArticle\Block\Adminhtml\Category\Edit $block */
$category = $block->getCategory();
$isActive = $category->getId() ? (int) $category->getIsActive() : 1;
?>
<div class="blogarticle-category-edit">
    <div class="page-actions" style="margin-bottom:1rem;">
        <a href="<?= $block->escapeUrl($block->getBackUrl()) ?>"><?= $block->escapeHtml(__('Back to list')) ?></a>
        <?php if ($block->isExisting()): ?>
            &nbsp;|&nbsp;
            <a href="<?= $block->escapeUrl($block->getDeleteUrl()) ?>"
               onclick="return confirm('<?= $block->escapeJs(__('Delete this category?')) ?>');">
                <?= $block->escapeHtml(__('Delete')) ?>
            </a>
        <?php endif; ?>
    </div>

    <form action="<?= $block->escapeUrl($block->getSaveUrl()) ?>" method="post">
        <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->getFormKey()) ?>"/>
        <?php if ($category->getId()): ?>
            <input type="hidden" name="category_id" value="<?= $block->escapeHtmlAttr((string) $category->getId()) ?>"/>
        <?php endif; ?>

        <div style="margin-bottom:1rem;">
            <label for="name"><?= $block->escapeHtml(__('Name')) ?> *</label><br/>
            <input type="text" id="name" name="name" required="required" maxlength="255"
                   style="width:100%;max-width:480px;"
                   value="<?= $block->escapeHtmlAttr((string) $category->getName()) ?>"/>
        </div>
        <div style="margin-bottom:1rem;">
            <label for="url_key"><?= $block->escapeHtml(__('URL Key')) ?></label><br/>
            <input type="text" id="url_key" name="url_key" maxlength="255"
                   style="width:100%;max-width:480px;"
                   value="<?= $block->escapeHtmlAttr((string) $category->getUrlKey()) ?>"/>
        </div>
        <div style="margin-bottom:1rem;">
            <label for="description"><?= $block->escapeHtml(__('Description')) ?></label><br/>
            <textarea id="description" name="description" rows="5"
                      style="width:100%;max-width:640px;"
                      placeholder="<?= $block->escapeHtmlAttr(__('Optional intro text on the category list page')) ?>"
            ><?= $block->escapeHtml((string) $category->getData('description')) ?></textarea>
        </div>
        <div style="margin-bottom:1rem;">
            <label for="sort_order"><?= $block->escapeHtml(__('Sort Order')) ?></label><br/>
            <input type="number" id="sort_order" name="sort_order" min="0" step="1"
                   style="width:100%;max-width:160px;"
                   value="<?= (int) $category->getData('sort_order') ?>"/>
            <p class="note" style="margin-top:0.35rem;">
                <?= $block->escapeHtml(__('Lower numbers appear first in storefront category lists.')) ?>
            </p>
        </div>
        <div style="margin-bottom:1rem;">
            <label for="is_active"><?= $block->escapeHtml(__('Status')) ?></label><br/>
            <select id="is_active" name="is_active">
