<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="head.additional">
            <block class="ThirdParty\BlogArticle\Block\Post\View"
                   name="blog.post.seo"
                   template="ThirdParty_BlogArticle::post/seo.phtml"/>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="ThirdParty\BlogArticle\Block\Post\View"
                   name="blog.post.view"
                   template="ThirdParty_BlogArticle::post/view.phtml"
                   cacheable="true"/>
        </referenceContainer>
    </body>
</page>
