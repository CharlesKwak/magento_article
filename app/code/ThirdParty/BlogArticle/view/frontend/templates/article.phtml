<?php
/** @var \ThirdParty\BlogArticle\Block\Article $block */
$posts = $block->getPosts();
$currentPage = $block->getCurrentPage();
$lastPage = $block->getLastPageNumber();
$searchQuery = $block->getSearchQuery();
?>
<div class="blog-post-list">
    <form class="blog-search" method="get" action="<?= $block->escapeUrl($block->getSearchFormAction()) ?>"
          style="margin-bottom: 1rem; display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center;">
        <label for="blog-search-q" class="label">
            <span><?= $block->escapeHtml(__('Search')) ?></span>
        </label>
        <input type="search"
               id="blog-search-q"
               name="q"
               value="<?= $block->escapeHtmlAttr($searchQuery) ?>"
               placeholder="<?= $block->escapeHtmlAttr(__('Search posts…')) ?>"
               style="min-width: 220px;"/>
        <?php if ($block->getCategoryKeyFilter() !== ''): ?>
            <input type="hidden" name="cat" value="<?= $block->escapeHtmlAttr($block->getCategoryKeyFilter()) ?>"/>
        <?php elseif ($block->getCategoryIdFilter()): ?>
            <input type="hidden" name="category_id" value="<?= (int) $block->getCategoryIdFilter() ?>"/>
        <?php endif; ?>
        <?php if ($block->getTagKeyFilter() !== ''): ?>
            <input type="hidden" name="tag" value="<?= $block->escapeHtmlAttr($block->getTagKeyFilter()) ?>"/>
        <?php elseif ($block->getTagIdFilter()): ?>
            <input type="hidden" name="tag_id" value="<?= (int) $block->getTagIdFilter() ?>"/>
        <?php endif; ?>
        <button type="submit" class="action primary">
            <span><?= $block->escapeHtml(__('Search')) ?></span>
        </button>
        <?php if ($searchQuery !== '' || $block->getCategoryIdFilter() || $block->getTagIdFilter()): ?>
            <a href="<?= $block->escapeUrl($block->getUrl('blog/index/index')) ?>">
                <?= $block->escapeHtml(__('Clear')) ?>
            </a>
        <?php endif; ?>
    </form>

    <?php $categories = $block->getActiveCategories(); ?>
    <?php if ($categories->getSize()): ?>
        <nav class="blog-categories" style="margin-bottom:0.75rem; display:flex; gap:0.75rem; flex-wrap:wrap;">
            <strong><?= $block->escapeHtml(__('Categories:')) ?></strong>
            <a href="<?= $block->escapeUrl($block->getUrl('blog/index/index')) ?>"
               <?= !$block->getCategoryIdFilter() ? 'style="font-weight:bold;"' : '' ?>>
                <?= $block->escapeHtml(__('All')) ?>
            </a>
            <?php foreach ($categories as $category): ?>
                <a href="<?= $block->escapeUrl($block->getCategoryFilterUrl((string) $category->getUrlKey())) ?>"
                   <?= (int) $block->getCategoryIdFilter() === (int) $category->getId() ? 'style="font-weight:bold;"' : '' ?>>
                    <?= $block->escapeHtml($category->getName()) ?>
                </a>
            <?php endforeach; ?>
        </nav>
    <?php endif; ?>

    <?php $tags = $block->getActiveTags(); ?>
    <?php if ($tags->getSize()): ?>
        <nav class="blog-tags" style="margin-bottom:1.25rem; display:flex; gap:0.75rem; flex-wrap:wrap;">
            <strong><?= $block->escapeHtml(__('Tags:')) ?></strong>
            <?php foreach ($tags as $tag): ?>
                <a href="<?= $block->escapeUrl($block->getTagFilterUrl((string) $tag->getUrlKey())) ?>"
                   <?= (int) $block->getTagIdFilter() === (int) $tag->getId() ? 'style="font-weight:bold;"' : '' ?>>
                    #<?= $block->escapeHtml($tag->getName()) ?>
                </a>
            <?php endforeach; ?>
        </nav>
    <?php endif; ?>

    <?php if ($searchQuery !== ''): ?>
        <p class="blog-search-summary">
            <?= $block->escapeHtml(
                __('Results for “%1” (%2)', $searchQuery, $block->getTotalCount())
            ) ?>
        </p>
    <?php endif; ?>

    <?php if (!$posts->getSize()): ?>
        <div class="blog-empty">
            <?php if ($searchQuery !== ''): ?>
                <p><?= $block->escapeHtml(__('No posts matched your search.')) ?></p>
            <?php else: ?>
                <p><?= $block->escapeHtml(__('No blog posts are available yet.')) ?></p>
            <?php endif; ?>
        </div>
    <?php else: ?>
        <?php foreach ($posts as $post): ?>
            <article class="blog-post blog-post-summary">
                <h2>
                    <a href="<?= $block->escapeUrl($block->getPostUrl($post)) ?>">
                        <?= $block->escapeHtml($post->getTitle()) ?>
                    </a>
                </h2>
                <p class="blog-meta">
                    <?php if ($block->getCategoryName($post) !== ''): ?>
                        <span class="blog-category"><?= $block->escapeHtml($block->getCategoryName($post)) ?></span>
                        &middot;
                    <?php endif; ?>
                    <?php if ($post->getCreationTime()): ?>
                        <time datetime="<?= $block->escapeHtmlAttr((string) $post->getCreationTime()) ?>">
                            <?= $block->escapeHtml((string) $post->getCreationTime()) ?>
                        </time>
                    <?php endif; ?>
                </p>
                <?php $tagNames = $block->getTagNames($post); ?>
                <?php if ($tagNames): ?>
                    <p class="blog-post-tags">
                        <?php foreach ($tagNames as $tagName): ?>
                            <span class="blog-tag">#<?= $block->escapeHtml($tagName) ?></span>
                        <?php endforeach; ?>
                    </p>
                <?php endif; ?>
                <div class="excerpt">
                    <p><?= $block->escapeHtml($block->getExcerpt($post)) ?></p>
                </div>
                <p class="blog-read-more">
                    <a href="<?= $block->escapeUrl($block->getPostUrl($post)) ?>">
                        <?= $block->escapeHtml(__('Read more')) ?>
                    </a>
                </p>
            </article>
        <?php endforeach; ?>

        <?php if ($block->hasPager()): ?>
            <nav class="blog-pager" aria-label="<?= $block->escapeHtmlAttr(__('Blog pagination')) ?>"
                 style="margin-top: 1.5rem; display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap;">
                <?php if ($currentPage > 1): ?>
                    <a class="action previous" href="<?= $block->escapeUrl($block->getPageUrl($currentPage - 1)) ?>">
                        <?= $block->escapeHtml(__('Previous')) ?>
                    </a>
                <?php endif; ?>

                <span class="blog-pager-status">
                    <?= $block->escapeHtml(
                        __('Page %1 of %2 (%3 posts)', $currentPage, $lastPage, $block->getTotalCount())
                    ) ?>
                </span>

                <?php if ($currentPage < $lastPage): ?>
                    <a class="action next" href="<?= $block->escapeUrl($block->getPageUrl($currentPage + 1)) ?>">
                        <?= $block->escapeHtml(__('Next')) ?>
                    </a>
                <?php endif; ?>

                <span class="blog-pager-pages" style="display:flex; gap:0.35rem;">
                    <?php for ($page = 1; $page <= $lastPage; $page++): ?>
                        <?php if ($page === $currentPage): ?>
                            <strong><?= (int) $page ?></strong>
                        <?php else: ?>
                            <a href="<?= $block->escapeUrl($block->getPageUrl($page)) ?>"><?= (int) $page ?></a>
                        <?php endif; ?>
                    <?php endfor; ?>
                </span>
            </nav>
        <?php endif; ?>
    <?php endif; ?>
</div>
