<?php
/** @var \ThirdParty\BlogArticle\Block\Product\RelatedPosts $block */
$posts = $block->getPosts();
?>
<div class="block block-blogarticle-product-related">
    <div class="block-title">
        <strong><?= $block->escapeHtml($block->getBlockTitle()) ?></strong>
    </div>
    <div class="block-content">
        <ul class="blogarticle-product-related-list">
            <?php foreach ($posts as $post): ?>
                <li>
                    <a href="<?= $block->escapeUrl($block->getPostUrl($post)) ?>">
                        <?= $block->escapeHtml((string) $post->getTitle()) ?>
                    </a>
                </li>
            <?php endforeach; ?>
        </ul>
    </div>
</div>
