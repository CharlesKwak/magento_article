<?php
/** @var \ThirdParty\BlogArticle\Block\Sidebar\Archive $block */
$months = $block->getMonths();
if (!$months) {
    return;
}
?>
<div class="block block-blogarticle-archive">
    <div class="block-title">
        <strong><?= $block->escapeHtml($block->getBlockTitle()) ?></strong>
    </div>
    <div class="block-content">
        <ul class="blogarticle-archive-list" style="list-style:none;padding:0;margin:0;">
            <?php foreach ($months as $month): ?>
                <li style="margin:0.35rem 0;">
                    <a href="<?= $block->escapeUrl($month['url']) ?>">
                        <?= $block->escapeHtml($month['label']) ?>
                    </a>
                    <span class="blogarticle-archive-count" style="opacity:0.7;">
                        (<?= (int) $month['count'] ?>)
                    </span>
                </li>
            <?php endforeach; ?>
        </ul>
    </div>
</div>
