<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="thirdparty" translate="label" sortOrder="400">
            <label>Third Party</label>
        </tab>
        <section id="blogarticle" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Blog Article</label>
            <tab>thirdparty</tab>
            <resource>ThirdParty_BlogArticle::config</resource>

            <group id="general" translate="label" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="blog_name" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Blog Name</label>
                    <comment>Shown in navigation, breadcrumbs, and widgets. Default: Blog.</comment>
                </field>
                <field id="show_top_menu" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Link in Top Menu</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Adds a Blog link to the storefront top navigation.</comment>
                </field>
                <field id="show_footer_link" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Link in Footer</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <group id="list" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Storefront List</label>
                <field id="page_size" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Posts Per Page</label>
                    <comment>Number of posts on the blog list (1–50). Default: 5.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>

            <group id="seo" translate="label" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>SEO (List Page)</label>
                <field id="list_meta_title" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Meta Title for Blog List</label>
                    <comment>Leave empty to use the blog name.</comment>
                </field>
                <field id="list_meta_description" translate="label" type="textarea" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Meta Description for Blog List</label>
                </field>
                <field id="hreflang_enabled" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Emit hreflang Alternates</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Adds link rel=alternate hreflang for other store views when multi-store is used.</comment>
                </field>
                <field id="amphtml_enabled" translate="label comment" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Emit amphtml Link Hint</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Adds &lt;link rel="amphtml"&gt; on post detail when a URL pattern is set. This module does not render AMP pages.</comment>
                </field>
                <field id="amphtml_url_pattern" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>amphtml URL Pattern</label>
                    <comment>Example: {base_url}amp/blog/{url_key} or https://cdn.example.com/amp/{url_key}. Tokens: {base_url}, {url_key}, {post_id}.</comment>
                    <depends>
                        <field id="amphtml_enabled">1</field>
                    </depends>
                </field>
                <field id="list_faq_schema_enabled" translate="label comment" type="select" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Emit FAQPage Schema on Blog List</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Adds JSON-LD FAQPage on the blog list (built-in Q&amp;A or custom JSON below).</comment>
                </field>
                <field id="list_faq_schema_json" translate="label comment" type="textarea" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom FAQ JSON</label>
                    <comment>Optional. JSON array: [{"question":"…","answer":"…"}]. Leave empty to use built-in defaults.</comment>
                    <depends>
                        <field id="list_faq_schema_enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="display" translate="label" sortOrder="16" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Display</label>
                <field id="reading_mode_link" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Reading Mode Link</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>On post detail, offer a distraction-free 1-column reading view (?reading=1).</comment>
                </field>
                <field id="lazy_load_images" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Lazy-load Featured Images</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Adds loading="lazy" and decoding="async" to featured images on list and post pages.</comment>
                </field>
                <field id="toc_enabled" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Table of Contents</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>On post detail, auto-build a TOC from h2–h4 headings in the body (IDs added for anchor links).</comment>
                </field>
                <field id="toc_min_headings" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minimum Headings for TOC</label>
                    <comment>TOC is shown only when the body has at least this many h2–h4 headings (1–20). Default: 2.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="toc_enabled">1</field>
                    </depends>
                </field>
                <field id="related_posts_limit" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Related Posts Limit</label>
                    <comment>On post detail, max related posts (category match, then shared tags, then recent). 1–20. Default: 3.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="reading_progress" translate="label comment" type="select" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Reading Progress Bar</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Thin top bar that fills as the visitor scrolls through the post body.</comment>
                </field>
            </group>

            <group id="sidebar" translate="label" sortOrder="18" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Sidebar</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Blog Sidebar</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Shows recent posts (and optional search) on list and post pages.</comment>
                </field>
                <field id="recent_count" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Number of Recent Posts</label>
                    <comment>1–20. Default: 5.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="show_search" translate="label" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Search Box</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="show_most_viewed" translate="label comment" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Most Viewed</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Requires storefront view tracking (enabled automatically on post open).</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="most_viewed_count" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Number of Most Viewed Posts</label>
                    <comment>1–20. Default: 5.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="show_most_viewed">1</field>
                    </depends>
                </field>
                <field id="show_archive" translate="label comment" type="select" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Monthly Archive</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Lists months with post counts; links to /blog/archive/YYYY/MM.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="archive_limit" translate="label comment" type="text" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Archive Months to Show</label>
                    <comment>1–60. Default: 12.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="show_archive">1</field>
                    </depends>
                </field>
                <field id="show_recent_comments" translate="label comment" type="select" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Recent Comments</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Lists latest approved comments with links to their posts.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="recent_comments_count" translate="label comment" type="text" sortOrder="90"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Number of Recent Comments</label>
                    <comment>1–20. Default: 5.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="show_recent_comments">1</field>
                    </depends>
                </field>
            </group>

            <group id="catalog" translate="label" sortOrder="19" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Catalog Integration</label>
                <field id="show_related_posts" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Related Posts on Product Page</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When a product is linked on a blog post, show those posts on the product page.</comment>
                </field>
                <field id="related_posts_limit" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Related Posts Limit</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="show_related_posts">1</field>
                    </depends>
                </field>
            </group>

            <group id="comments" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Comments</label>
                <field id="enabled" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Comments</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="auto_approve" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Auto-approve Comments</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>If No, comments require Admin approval under Content &gt; Blog Comments.</comment>
                </field>
                <field id="spam_protection" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Spam Protection</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Honeypot field, minimum form fill time, basic link-flood checks.</comment>
                </field>
                <field id="min_submit_seconds" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minimum Seconds Before Submit</label>
                    <comment>Reject comments submitted faster than this (0–120). Default: 3.</comment>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="spam_protection">1</field>
                    </depends>
                </field>
                <field id="notify_enabled" translate="label" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Email Notify on New Comment</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="notify_email" translate="label comment" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Notification Email</label>
                    <comment>Leave empty to use General Contact email (Stores &gt; Configuration &gt; General &gt; Store Email Addresses).</comment>
                    <validate>validate-email</validate>
                    <depends>
                        <field id="notify_enabled">1</field>
                    </depends>
                </field>
                <field id="recaptcha_enabled" translate="label comment" type="select" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Google reCAPTCHA</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Optional. Requires site key and secret from Google reCAPTCHA admin. Supports v2 checkbox and v3 (score).</comment>
                </field>
                <field id="recaptcha_site_key" translate="label" type="text" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>reCAPTCHA Site Key</label>
                    <depends>
                        <field id="recaptcha_enabled">1</field>
                    </depends>
                </field>
                <field id="recaptcha_secret_key" translate="label comment" type="obscure" sortOrder="90"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>reCAPTCHA Secret Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Masked and encrypted at rest. Required when reCAPTCHA is enabled.</comment>
                    <depends>
                        <field id="recaptcha_enabled">1</field>
                    </depends>
                </field>
                <field id="recaptcha_min_score" translate="label comment" type="text" sortOrder="100"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>reCAPTCHA v3 Minimum Score</label>
                    <comment>0.0–1.0. Used only when Google returns a score (v3). Default: 0.5.</comment>
                    <validate>validate-number validate-number-range number-range-0-1</validate>
                    <depends>
                        <field id="recaptcha_enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="media" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Media</label>
                <field id="max_upload_kb" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Max Featured Image Size (KB)</label>
                    <comment>Maximum upload size for featured images (100–10240). Default: 2048.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
        </section>
    </system>
</config>
