# Copyright © ThirdParty. Blog Article GraphQL schema.

type BlogCategory {
    category_id: Int
    name: String
    url_key: String
    description: String
    is_active: Int
    creation_time: String
    update_time: String
}

type BlogArchiveMonth {
    year: Int
    month: Int
    count: Int
    label: String
    url_path: String
    url: String
}

type BlogTag {
    tag_id: Int
    name: String
    url_key: String
    description: String
    is_active: Int
    creation_time: String
    update_time: String
}

type BlogComment {
    comment_id: Int
    post_id: Int
    parent_id: Int
    author_name: String
    author_email: String
    content: String
    is_approved: Int
    creation_time: String
}

type BlogPost {
    post_id: Int
    title: String
    author: String
    url_key: String
    content: String
    excerpt: String
    featured_image: String
    meta_title: String
    meta_description: String
    meta_robots: String
    is_active: Int
    view_count: Int
    category_id: Int
    store_id: Int
    tag_ids: [Int]
    creation_time: String
    update_time: String
    published_at: String
    related_posts(limit: Int = 3): [BlogPost]
        @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\RelatedPosts")
        @doc(description: "Related posts. limit 1–20 (default 3). Nested related_posts are not expanded server-side beyond this call.")
    comments: [BlogComment]
        @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\PostComments")
}

type BlogPostList {
    items: [BlogPost]!
    total_count: Int
    page_size: Int
    current_page: Int
    total_pages: Int
}

type BlogStats {
    posts_total: Int
    posts_enabled: Int
    comments_total: Int
    comments_pending: Int
    categories_total: Int
    tags_total: Int
    views_total: Int
}

input BlogPostInput {
    title: String
    author: String
    url_key: String
    content: String
    excerpt: String
    featured_image: String
    meta_title: String
    meta_description: String
    meta_robots: String
    is_active: Int
    category_id: Int
    store_id: Int
    tag_ids: [Int]
    published_at: String
}

type Query {
    blogPosts(
        pageSize: Int = 10
        currentPage: Int = 1
        search: String
        categoryId: Int
        tagId: Int
        author: String
        year: Int
        month: Int
    ): BlogPostList
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\Posts")
    @doc(description: "List posts. Optional author is display name or URL slug (spaces as hyphens). year/month filter by publish date.")

    blogPost(id: Int, url_key: String): BlogPost
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\Post")

    blogCategories: [BlogCategory]!
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\Categories")

    blogCategory(id: Int, url_key: String): BlogCategory
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\Category")

    blogTags: [BlogTag]!
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\Tags")

    blogTag(id: Int, url_key: String): BlogTag
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\Tag")

    blogArchives(limit: Int = 24): [BlogArchiveMonth]!
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\Archives")
    @doc(description: "Monthly archive buckets with post counts (limit 1–120).")

    blogStats: BlogStats
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\BlogStats")
    @doc(description: "Blog metrics for admin/integration identity (posts, comments, views).")
}

type Mutation {
    createBlogPost(input: BlogPostInput!): BlogPost
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\CreateBlogPost")
    @doc(description: "Create post (admin/integration identity required)")

    updateBlogPost(post_id: Int!, input: BlogPostInput!): BlogPost
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\UpdateBlogPost")
    @doc(description: "Update post (admin/integration identity required)")

    deleteBlogPost(post_id: Int!): Boolean
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\DeleteBlogPost")
    @doc(description: "Delete post (admin/integration identity required)")

    submitBlogComment(
        post_id: Int!
        author_name: String!
        author_email: String
        content: String!
        parent_id: Int
        recaptcha_token: String
    ): BlogComment
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\SubmitBlogComment")
    @doc(description: "Submit a storefront comment (public when comments enabled). Optional parent_id for one-level replies; recaptcha_token required when reCAPTCHA is enabled.")

    approveBlogComment(comment_id: Int!): BlogComment
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\ApproveBlogComment")
    @doc(description: "Approve a comment (admin/integration identity required)")

    deleteBlogComment(comment_id: Int!): Boolean
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\DeleteBlogComment")
    @doc(description: "Delete a comment (admin/integration identity required)")
}
