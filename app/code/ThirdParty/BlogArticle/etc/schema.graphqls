# Copyright © ThirdParty. Blog Article GraphQL schema.

type BlogCategory {
    category_id: Int
    name: String
    url_key: String
    is_active: Int
    creation_time: String
    update_time: String
}

type BlogTag {
    tag_id: Int
    name: String
    url_key: String
    is_active: Int
    creation_time: String
    update_time: String
}

type BlogPost {
    post_id: Int
    title: String
    url_key: String
    content: String
    is_active: Int
    category_id: Int
    tag_ids: [Int]
    creation_time: String
    update_time: String
}

type BlogPostList {
    items: [BlogPost]!
    total_count: Int
    page_size: Int
    current_page: Int
    total_pages: Int
}

type Query {
    blogPosts(
        pageSize: Int = 10
        currentPage: Int = 1
        search: String
        categoryId: Int
        tagId: Int
    ): BlogPostList
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\Posts")

    blogPost(id: Int, url_key: String): BlogPost
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\Post")

    blogCategories: [BlogCategory]!
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\Categories")

    blogCategory(id: Int, url_key: String): BlogCategory
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\Category")

    blogTags: [BlogTag]!
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\Tags")

    blogTag(id: Int, url_key: String): BlogTag
    @resolver(class: "ThirdParty\\BlogArticle\\Model\\Resolver\\Tag")
}
