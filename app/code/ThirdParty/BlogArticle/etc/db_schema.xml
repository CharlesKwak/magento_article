<?xml version="1.0"?>
<!--
  Declarative schema for ThirdParty_BlogArticle (Magento 2.4+).
  Mirrors InstallSchema + cumulative Schema patches (including view_count, post_product, comment parent_id).
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="thirdparty_blogarticle_category" resource="default" engine="innodb" comment="BlogArticle Categories">
        <column xsi:type="int" name="category_id" unsigned="true" nullable="false" identity="true" comment="Category ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="varchar" name="url_key" nullable="true" length="255" comment="URL Key"/>
        <column xsi:type="text" name="description" nullable="true" comment="Category description (plain/HTML)"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="creation_time" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <column xsi:type="timestamp" name="update_time" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Update Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="category_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="THIRDPARTY_BLOGARTICLE_CATEGORY_URL_KEY">
            <column name="url_key"/>
        </constraint>
    </table>

    <table name="thirdparty_blogarticle_tag" resource="default" engine="innodb" comment="BlogArticle Tags">
        <column xsi:type="int" name="tag_id" unsigned="true" nullable="false" identity="true" comment="Tag ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="varchar" name="url_key" nullable="true" length="255" comment="URL Key"/>
        <column xsi:type="text" name="description" nullable="true" comment="Tag description (plain/HTML)"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="creation_time" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <column xsi:type="timestamp" name="update_time" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Update Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="tag_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="THIRDPARTY_BLOGARTICLE_TAG_URL_KEY">
            <column name="url_key"/>
        </constraint>
    </table>

    <table name="thirdparty_blogarticle_post" resource="default" engine="innodb" comment="BlogArticle Posts">
        <column xsi:type="int" name="post_id" unsigned="true" nullable="false" identity="true" comment="Post ID"/>
        <column xsi:type="varchar" name="title" nullable="false" length="255" comment="Title"/>
        <column xsi:type="varchar" name="author" nullable="true" length="255" comment="Post author display name"/>
        <column xsi:type="varchar" name="url_key" nullable="true" length="255" comment="URL Key"/>
        <column xsi:type="text" name="content" nullable="false" comment="Content"/>
        <column xsi:type="varchar" name="excerpt" nullable="true" length="1024" comment="Manual excerpt for list summaries"/>
        <column xsi:type="varchar" name="featured_image" nullable="true" length="512" comment="Featured image URL or media path"/>
        <column xsi:type="varchar" name="meta_title" nullable="true" length="255" comment="Meta title"/>
        <column xsi:type="varchar" name="meta_description" nullable="true" length="512" comment="Meta description"/>
        <column xsi:type="varchar" name="meta_robots" nullable="true" length="32" comment="Robots meta (INDEX,FOLLOW etc). Empty = INDEX,FOLLOW"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="int" name="view_count" unsigned="true" nullable="false" default="0" comment="Storefront view counter"/>
        <column xsi:type="int" name="category_id" unsigned="true" nullable="true" comment="Category ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="true" comment="Store ID (NULL = all stores)"/>
        <column xsi:type="timestamp" name="creation_time" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <column xsi:type="timestamp" name="update_time" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Update Time"/>
        <column xsi:type="timestamp" name="published_at" on_update="false" nullable="true" comment="Publish date/time for sorting"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="post_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="THIRDPARTY_BLOGARTICLE_POST_URL_KEY">
            <column name="url_key"/>
        </constraint>
        <index referenceId="THIRDPARTY_BLOGARTICLE_POST_CATEGORY_ID" indexType="btree">
            <column name="category_id"/>
        </index>
        <index referenceId="THIRDPARTY_BLOGARTICLE_POST_STORE_ID" indexType="btree">
            <column name="store_id"/>
        </index>
        <index referenceId="THIRDPARTY_BLOGARTICLE_POST_VIEW_COUNT" indexType="btree">
            <column name="view_count"/>
        </index>
    </table>

    <table name="thirdparty_blogarticle_post_tag" resource="default" engine="innodb" comment="BlogArticle Post-Tag Link">
        <column xsi:type="int" name="post_id" unsigned="true" nullable="false" comment="Post ID"/>
        <column xsi:type="int" name="tag_id" unsigned="true" nullable="false" comment="Tag ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="post_id"/>
            <column name="tag_id"/>
        </constraint>
        <index referenceId="THIRDPARTY_BLOGARTICLE_POST_TAG_TAG_ID" indexType="btree">
            <column name="tag_id"/>
        </index>
    </table>

    <table name="thirdparty_blogarticle_comment" resource="default" engine="innodb" comment="BlogArticle Comments">
        <column xsi:type="int" name="comment_id" unsigned="true" nullable="false" identity="true" comment="Comment ID"/>
        <column xsi:type="int" name="post_id" unsigned="true" nullable="false" comment="Post ID"/>
        <column xsi:type="int" name="parent_id" unsigned="true" nullable="true" comment="Parent comment ID for one-level replies"/>
        <column xsi:type="varchar" name="author_name" nullable="false" length="255" comment="Author name"/>
        <column xsi:type="varchar" name="author_email" nullable="true" length="255" comment="Author email"/>
        <column xsi:type="text" name="content" nullable="false" comment="Comment body"/>
        <column xsi:type="smallint" name="is_approved" unsigned="true" nullable="false" default="0" comment="Is approved"/>
        <column xsi:type="timestamp" name="creation_time" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="comment_id"/>
        </constraint>
        <index referenceId="THIRDPARTY_BLOGARTICLE_COMMENT_POST_ID" indexType="btree">
            <column name="post_id"/>
        </index>
        <index referenceId="THIRDPARTY_BLOGARTICLE_COMMENT_IS_APPROVED" indexType="btree">
            <column name="is_approved"/>
        </index>
        <index referenceId="THIRDPARTY_BLOGARTICLE_COMMENT_PARENT_ID" indexType="btree">
            <column name="parent_id"/>
        </index>
    </table>

    <table name="thirdparty_blogarticle_post_product" resource="default" engine="innodb" comment="BlogArticle Post to Catalog Product">
        <column xsi:type="int" name="post_id" unsigned="true" nullable="false" comment="Post ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" comment="Product ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="post_id"/>
            <column name="product_id"/>
        </constraint>
        <index referenceId="THIRDPARTY_BLOGARTICLE_POST_PRODUCT_PRODUCT_ID" indexType="btree">
            <column name="product_id"/>
        </index>
    </table>
</schema>
