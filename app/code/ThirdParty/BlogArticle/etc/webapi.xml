<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <!-- Public post read -->
    <route url="/V1/blogarticle/posts" method="GET">
        <service class="ThirdParty\BlogArticle\Api\PostRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/blogarticle/posts/count" method="GET">
        <service class="ThirdParty\BlogArticle\Api\PostRepositoryInterface" method="getListTotalCount"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/blogarticle/posts/:postId" method="GET">
        <service class="ThirdParty\BlogArticle\Api\PostRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/blogarticle/posts/url/:urlKey" method="GET">
        <service class="ThirdParty\BlogArticle\Api\PostRepositoryInterface" method="getByUrlKey"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/blogarticle/posts/:postId/related" method="GET">
        <service class="ThirdParty\BlogArticle\Api\PostRepositoryInterface" method="getRelated"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <!-- Admin post write -->
    <route url="/V1/blogarticle/posts" method="POST">
        <service class="ThirdParty\BlogArticle\Api\PostRepositoryInterface" method="save"/>
        <resources>
            <resource ref="ThirdParty_BlogArticle::posts"/>
        </resources>
    </route>
    <route url="/V1/blogarticle/posts/:postId" method="PUT">
        <service class="ThirdParty\BlogArticle\Api\PostRepositoryInterface" method="save"/>
        <resources>
            <resource ref="ThirdParty_BlogArticle::posts"/>
        </resources>
        <data>
            <parameter name="post.post_id" force="true">%postId%</parameter>
        </data>
    </route>
    <route url="/V1/blogarticle/posts/:postId" method="DELETE">
        <service class="ThirdParty\BlogArticle\Api\PostRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="ThirdParty_BlogArticle::posts"/>
        </resources>
    </route>

    <!-- Categories -->
    <route url="/V1/blogarticle/categories" method="GET">
        <service class="ThirdParty\BlogArticle\Api\CategoryRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/blogarticle/categories/:categoryId" method="GET">
        <service class="ThirdParty\BlogArticle\Api\CategoryRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/blogarticle/categories/url/:urlKey" method="GET">
        <service class="ThirdParty\BlogArticle\Api\CategoryRepositoryInterface" method="getByUrlKey"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/blogarticle/categories" method="POST">
        <service class="ThirdParty\BlogArticle\Api\CategoryRepositoryInterface" method="save"/>
        <resources>
            <resource ref="ThirdParty_BlogArticle::categories"/>
        </resources>
    </route>
    <route url="/V1/blogarticle/categories/:categoryId" method="PUT">
        <service class="ThirdParty\BlogArticle\Api\CategoryRepositoryInterface" method="save"/>
        <resources>
            <resource ref="ThirdParty_BlogArticle::categories"/>
        </resources>
        <data>
            <parameter name="category.category_id" force="true">%categoryId%</parameter>
        </data>
    </route>
    <route url="/V1/blogarticle/categories/:categoryId" method="DELETE">
        <service class="ThirdParty\BlogArticle\Api\CategoryRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="ThirdParty_BlogArticle::categories"/>
        </resources>
    </route>

    <!-- Tags -->
    <route url="/V1/blogarticle/tags" method="GET">
        <service class="ThirdParty\BlogArticle\Api\TagRepositoryInterface" method="getList"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
    <route url="/V1/blogarticle/tags/:tagId" method="GET">
        <service class="ThirdParty\BlogArticle\Api\TagRepositoryInterface" method="getById"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
    <route url="/V1/blogarticle/tags/url/:urlKey" method="GET">
        <service class="ThirdParty\BlogArticle\Api\TagRepositoryInterface" method="getByUrlKey"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
    <route url="/V1/blogarticle/tags" method="POST">
        <service class="ThirdParty\BlogArticle\Api\TagRepositoryInterface" method="save"/>
        <resources><resource ref="ThirdParty_BlogArticle::tags"/></resources>
    </route>
    <route url="/V1/blogarticle/tags/:tagId" method="PUT">
        <service class="ThirdParty\BlogArticle\Api\TagRepositoryInterface" method="save"/>
        <resources><resource ref="ThirdParty_BlogArticle::tags"/></resources>
        <data>
            <parameter name="tag.tag_id" force="true">%tagId%</parameter>
        </data>
    </route>
    <route url="/V1/blogarticle/tags/:tagId" method="DELETE">
        <service class="ThirdParty\BlogArticle\Api\TagRepositoryInterface" method="deleteById"/>
        <resources><resource ref="ThirdParty_BlogArticle::tags"/></resources>
    </route>

    <!-- Comments (public read per post + submit) -->
    <route url="/V1/blogarticle/posts/:postId/comments" method="GET">
        <service class="ThirdParty\BlogArticle\Api\CommentRepositoryInterface" method="getListByPostId"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
    <route url="/V1/blogarticle/posts/:postId/comments/count" method="GET">
        <service class="ThirdParty\BlogArticle\Api\CommentRepositoryInterface" method="getListByPostIdTotalCount"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
    <route url="/V1/blogarticle/comments" method="POST">
        <service class="ThirdParty\BlogArticle\Api\CommentRepositoryInterface" method="submit"/>
        <resources><resource ref="anonymous"/></resources>
    </route>

    <!-- Comments (admin / integration) -->
    <route url="/V1/blogarticle/comments" method="GET">
        <service class="ThirdParty\BlogArticle\Api\CommentRepositoryInterface" method="getList"/>
        <resources><resource ref="ThirdParty_BlogArticle::comments"/></resources>
    </route>
    <route url="/V1/blogarticle/comments/count" method="GET">
        <service class="ThirdParty\BlogArticle\Api\CommentRepositoryInterface" method="getListTotalCount"/>
        <resources><resource ref="ThirdParty_BlogArticle::comments"/></resources>
    </route>
    <route url="/V1/blogarticle/comments/:commentId" method="GET">
        <service class="ThirdParty\BlogArticle\Api\CommentRepositoryInterface" method="getById"/>
        <resources><resource ref="ThirdParty_BlogArticle::comments"/></resources>
    </route>
    <route url="/V1/blogarticle/comments/:commentId" method="PUT">
        <service class="ThirdParty\BlogArticle\Api\CommentRepositoryInterface" method="save"/>
        <resources><resource ref="ThirdParty_BlogArticle::comments"/></resources>
        <data>
            <parameter name="comment.comment_id" force="true">%commentId%</parameter>
        </data>
    </route>
    <route url="/V1/blogarticle/comments/:commentId/approve" method="PUT">
        <service class="ThirdParty\BlogArticle\Api\CommentRepositoryInterface" method="approve"/>
        <resources><resource ref="ThirdParty_BlogArticle::comments"/></resources>
    </route>
    <route url="/V1/blogarticle/comments/:commentId" method="DELETE">
        <service class="ThirdParty\BlogArticle\Api\CommentRepositoryInterface" method="deleteById"/>
        <resources><resource ref="ThirdParty_BlogArticle::comments"/></resources>
    </route>

    <!-- Stats (admin / integration) -->
    <route url="/V1/blogarticle/stats" method="GET">
        <service class="ThirdParty\BlogArticle\Api\BlogStatsManagementInterface" method="get"/>
        <resources><resource ref="ThirdParty_BlogArticle::posts"/></resources>
    </route>

    <!-- Public monthly archives -->
    <route url="/V1/blogarticle/archives" method="GET">
        <service class="ThirdParty\BlogArticle\Api\BlogArchiveManagementInterface" method="getList"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
</routes>



