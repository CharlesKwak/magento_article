<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/blogarticle/posts" method="GET">
        <service class="ThirdParty\BlogArticle\Api\PostRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/blogarticle/posts/count" method="GET">
        <service class="ThirdParty\BlogArticle\Api\PostRepositoryInterface" method="getListTotalCount"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/blogarticle/posts/:postId" method="GET">
        <service class="ThirdParty\BlogArticle\Api\PostRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/blogarticle/posts/url/:urlKey" method="GET">
        <service class="ThirdParty\BlogArticle\Api\PostRepositoryInterface" method="getByUrlKey"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
