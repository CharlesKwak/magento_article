<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <blogarticle>
            <list>
                <page_size>5</page_size>
            </list>
            <comments>
                <enabled>1</enabled>
                <auto_approve>0</auto_approve>
                <spam_protection>1</spam_protection>
                <min_submit_seconds>3</min_submit_seconds>
                <notify_enabled>1</notify_enabled>
                <notify_email></notify_email>
                <recaptcha_enabled>0</recaptcha_enabled>
                <recaptcha_site_key></recaptcha_site_key>
                <recaptcha_secret_key></recaptcha_secret_key>
                <recaptcha_min_score>0.5</recaptcha_min_score>
            </comments>
            <media>
                <max_upload_kb>2048</max_upload_kb>
            </media>
        </blogarticle>
    </default>
</config>
