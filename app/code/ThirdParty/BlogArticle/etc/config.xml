<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <blogarticle>
            <general>
                <blog_name>Blog</blog_name>
                <show_top_menu>1</show_top_menu>
                <show_footer_link>1</show_footer_link>
            </general>
            <list>
                <page_size>5</page_size>
            </list>
            <seo>
                <list_meta_title></list_meta_title>
                <list_meta_description></list_meta_description>
            </seo>
            <sidebar>
                <enabled>1</enabled>
                <recent_count>5</recent_count>
                <show_search>1</show_search>
                <show_most_viewed>1</show_most_viewed>
                <most_viewed_count>5</most_viewed_count>
            </sidebar>
            <catalog>
                <show_related_posts>1</show_related_posts>
                <related_posts_limit>5</related_posts_limit>
            </catalog>
            <comments>
                <enabled>1</enabled>
                <auto_approve>0</auto_approve>
                <spam_protection>1</spam_protection>
                <min_submit_seconds>3</min_submit_seconds>
                <notify_enabled>1</notify_enabled>
                <notify_email></notify_email>
                <recaptcha_enabled>0</recaptcha_enabled>
                <recaptcha_site_key></recaptcha_site_key>
                <recaptcha_secret_key></recaptcha_secret_key>
                <recaptcha_min_score>0.5</recaptcha_min_score>
            </comments>
            <media>
                <max_upload_kb>2048</max_upload_kb>
            </media>
        </blogarticle>
    </default>
</config>
