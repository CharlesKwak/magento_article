<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="ThirdParty\BlogArticle\Api\PostRepositoryInterface"
                type="ThirdParty\BlogArticle\Model\PostRepository"/>
    <preference for="ThirdParty\BlogArticle\Api\Data\PostInterface"
                type="ThirdParty\BlogArticle\Model\Data\Post"/>
    <preference for="ThirdParty\BlogArticle\Api\CategoryRepositoryInterface"
                type="ThirdParty\BlogArticle\Model\CategoryRepository"/>
    <preference for="ThirdParty\BlogArticle\Api\Data\CategoryInterface"
                type="ThirdParty\BlogArticle\Model\Data\Category"/>
    <preference for="ThirdParty\BlogArticle\Api\TagRepositoryInterface"
                type="ThirdParty\BlogArticle\Model\TagRepository"/>
    <preference for="ThirdParty\BlogArticle\Api\Data\TagInterface"
                type="ThirdParty\BlogArticle\Model\Data\Tag"/>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="blogarticle_post_listing_data_source" xsi:type="string">
                    ThirdParty\BlogArticle\Model\ResourceModel\Post\Grid\Collection
                </item>
                <item name="blogarticle_category_listing_data_source" xsi:type="string">
                    ThirdParty\BlogArticle\Model\ResourceModel\Category\Grid\Collection
                </item>
                <item name="blogarticle_tag_listing_data_source" xsi:type="string">
                    ThirdParty\BlogArticle\Model\ResourceModel\Tag\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>
    <virtualType name="ThirdParty\BlogArticle\Model\ResourceModel\Post\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">thirdparty_blogarticle_post</argument>
            <argument name="resourceModel" xsi:type="string">ThirdParty\BlogArticle\Model\ResourceModel\Post</argument>
            <argument name="identifierName" xsi:type="string">post_id</argument>
        </arguments>
    </virtualType>
    <virtualType name="ThirdParty\BlogArticle\Model\ResourceModel\Category\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">thirdparty_blogarticle_category</argument>
            <argument name="resourceModel" xsi:type="string">ThirdParty\BlogArticle\Model\ResourceModel\Category</argument>
            <argument name="identifierName" xsi:type="string">category_id</argument>
        </arguments>
    </virtualType>
    <virtualType name="ThirdParty\BlogArticle\Model\ResourceModel\Tag\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">thirdparty_blogarticle_tag</argument>
            <argument name="resourceModel" xsi:type="string">ThirdParty\BlogArticle\Model\ResourceModel\Tag</argument>
            <argument name="identifierName" xsi:type="string">tag_id</argument>
        </arguments>
    </virtualType>

    <type name="Magento\Sitemap\Model\ItemProvider\Composite">
        <arguments>
            <argument name="itemProviders" xsi:type="array">
                <item name="blogarticle_posts" xsi:type="object">
                    ThirdParty\BlogArticle\Model\Sitemap\ItemProvider\Posts
                </item>
            </argument>
        </arguments>
    </type>
</config>
