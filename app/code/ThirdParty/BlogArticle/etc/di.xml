<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="ThirdParty\BlogArticle\Api\PostRepositoryInterface"
                type="ThirdParty\BlogArticle\Model\PostRepository"/>
    <preference for="ThirdParty\BlogArticle\Api\Data\PostInterface"
                type="ThirdParty\BlogArticle\Model\Data\Post"/>
    <preference for="ThirdParty\BlogArticle\Api\CategoryRepositoryInterface"
                type="ThirdParty\BlogArticle\Model\CategoryRepository"/>
    <preference for="ThirdParty\BlogArticle\Api\Data\CategoryInterface"
                type="ThirdParty\BlogArticle\Model\Data\Category"/>
    <preference for="ThirdParty\BlogArticle\Api\TagRepositoryInterface"
                type="ThirdParty\BlogArticle\Model\TagRepository"/>
    <preference for="ThirdParty\BlogArticle\Api\Data\TagInterface"
                type="ThirdParty\BlogArticle\Model\Data\Tag"/>
    <preference for="ThirdParty\BlogArticle\Api\CommentRepositoryInterface"
                type="ThirdParty\BlogArticle\Model\CommentRepository"/>
    <preference for="ThirdParty\BlogArticle\Api\Data\CommentInterface"
                type="ThirdParty\BlogArticle\Model\Data\Comment"/>
    <preference for="ThirdParty\BlogArticle\Api\BlogStatsManagementInterface"
                type="ThirdParty\BlogArticle\Model\BlogStatsManagement"/>
    <preference for="ThirdParty\BlogArticle\Api\Data\BlogStatsInterface"
                type="ThirdParty\BlogArticle\Model\Data\BlogStats"/>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="blogarticle_post_listing_data_source" xsi:type="string">
                    ThirdParty\BlogArticle\Model\ResourceModel\Post\Grid\Collection
                </item>
                <item name="blogarticle_category_listing_data_source" xsi:type="string">
                    ThirdParty\BlogArticle\Model\ResourceModel\Category\Grid\Collection
                </item>
                <item name="blogarticle_tag_listing_data_source" xsi:type="string">
                    ThirdParty\BlogArticle\Model\ResourceModel\Tag\Grid\Collection
                </item>
                <item name="blogarticle_comment_listing_data_source" xsi:type="string">
                    ThirdParty\BlogArticle\Model\ResourceModel\Comment\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>
    <virtualType name="ThirdParty\BlogArticle\Model\ResourceModel\Post\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">thirdparty_blogarticle_post</argument>
            <argument name="resourceModel" xsi:type="string">ThirdParty\BlogArticle\Model\ResourceModel\Post</argument>
            <argument name="identifierName" xsi:type="string">post_id</argument>
        </arguments>
    </virtualType>
    <virtualType name="ThirdParty\BlogArticle\Model\ResourceModel\Category\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">thirdparty_blogarticle_category</argument>
            <argument name="resourceModel" xsi:type="string">ThirdParty\BlogArticle\Model\ResourceModel\Category</argument>
            <argument name="identifierName" xsi:type="string">category_id</argument>
        </arguments>
    </virtualType>
    <virtualType name="ThirdParty\BlogArticle\Model\ResourceModel\Tag\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">thirdparty_blogarticle_tag</argument>
            <argument name="resourceModel" xsi:type="string">ThirdParty\BlogArticle\Model\ResourceModel\Tag</argument>
            <argument name="identifierName" xsi:type="string">tag_id</argument>
        </arguments>
    </virtualType>
    <virtualType name="ThirdParty\BlogArticle\Model\ResourceModel\Comment\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">thirdparty_blogarticle_comment</argument>
            <argument name="resourceModel" xsi:type="string">ThirdParty\BlogArticle\Model\ResourceModel\Comment</argument>
            <argument name="identifierName" xsi:type="string">comment_id</argument>
        </arguments>
    </virtualType>

    <type name="Magento\Sitemap\Model\ItemProvider\Composite">
        <arguments>
            <argument name="itemProviders" xsi:type="array">
                <item name="blogarticle_index" xsi:type="object">
                    ThirdParty\BlogArticle\Model\Sitemap\ItemProvider\Index
                </item>
                <item name="blogarticle_posts" xsi:type="object">
                    ThirdParty\BlogArticle\Model\Sitemap\ItemProvider\Posts
                </item>
                <item name="blogarticle_categories" xsi:type="object">
                    ThirdParty\BlogArticle\Model\Sitemap\ItemProvider\Categories
                </item>
                <item name="blogarticle_tags" xsi:type="object">
                    ThirdParty\BlogArticle\Model\Sitemap\ItemProvider\Tags
                </item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="blogarticle_post_list" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\PostListCommand
                </item>
                <item name="blogarticle_post_show" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\PostShowCommand
                </item>
                <item name="blogarticle_post_set_status" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\PostSetStatusCommand
                </item>
                <item name="blogarticle_post_create" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\PostCreateCommand
                </item>
                <item name="blogarticle_post_delete" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\PostDeleteCommand
                </item>
                <item name="blogarticle_category_list" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\CategoryListCommand
                </item>
                <item name="blogarticle_category_create" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\CategoryCreateCommand
                </item>
                <item name="blogarticle_category_set_status" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\CategorySetStatusCommand
                </item>
                <item name="blogarticle_tag_list" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\TagListCommand
                </item>
                <item name="blogarticle_tag_create" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\TagCreateCommand
                </item>
                <item name="blogarticle_tag_set_status" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\TagSetStatusCommand
                </item>
                <item name="blogarticle_category_delete" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\CategoryDeleteCommand
                </item>
                <item name="blogarticle_tag_delete" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\TagDeleteCommand
                </item>
                <item name="blogarticle_post_import" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\PostImportCommand
                </item>
                <item name="blogarticle_post_export" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\PostExportCommand
                </item>
                <item name="blogarticle_comment_export" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\CommentExportCommand
                </item>
                <item name="blogarticle_comment_import" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\CommentImportCommand
                </item>
                <item name="blogarticle_category_export" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\CategoryExportCommand
                </item>
                <item name="blogarticle_tag_export" xsi:type="object">
                    ThirdParty\BlogArticle\Console\Command\TagExportCommand
                </item>
            </argument>
        </arguments>
    </type>
</config>
