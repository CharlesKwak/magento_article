{
    "name": "thirdparty/module-blog-article",
    "description": "Free open-source Magento 2 blog module: Admin CRUD, storefront, sidebar, widgets, comments, SEO, REST, GraphQL, CLI and CSV import/export.",
    "type": "magento2-module",
    "license": [
        "GPL-2.0-only"
    ],
    "version": "2.13.0",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "files": [
            "app/code/ThirdParty/BlogArticle/registration.php"
        ],
        "psr-4": {
            "ThirdParty\\BlogArticle\\": "app/code/ThirdParty/BlogArticle/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "suggest": {
        "magento/framework": "Required when installed into Magento Open Source / Adobe Commerce 2.4.x (^103.0)."
    },
    "extra": {
        "magento": {
            "framework": "^103.0",
            "php": ">=8.1"
        }
    },
    "keywords": [
        "magento2",
        "magento",
        "blog",
        "magento2-module",
        "magento2-extension",
        "magento2-blog",
        "adobe-commerce",
        "graphql",
        "open-source"
    ],
    "homepage": "https://github.com/CharlesKwak/magento_article",
    "authors": [
        {
            "name": "Charles Kwak / ThirdParty",
            "homepage": "https://github.com/CharlesKwak/magento_article",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/CharlesKwak/magento_article",
        "issues": "https://github.com/CharlesKwak/magento_article/issues"
    }
}
